# Any OpenAI-compatible chat endpoint works. Leave LLM_API_KEY empty to run offline
# (keyword planner + plain result tables, no generated prose).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Ollama (local; any non-empty key):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Limits
# MAX_ROWS=200000
# MAX_UPLOAD_MB=25
